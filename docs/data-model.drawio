        <mxCell id="stops-r46-c1" value="raw  &lt;font color=&quot;#888888&quot;&gt;jsonb&lt;/font&gt;  &lt;font color=&quot;#3d7a3d&quot;&gt;not null&lt;/font&gt;" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="stops-r46"><mxGeometry x="46" width="314" height="22" as="geometry"/></mxCell>
        <mxCell id="e_src_orders" value="1 : N" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#82b366;fontColor=#82b366;verticalAlign=bottom;" edge="1" parent="1" source="sources-r0" target="orders-r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_src_prog" value="1 : N" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#9673a6;fontColor=#9673a6;verticalAlign=bottom;" edge="1" parent="1" source="sources-r0" target="progress-r0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_orders_stops" value="1 : N   (order_id, source_key)   on delete cascade" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#d79b00;fontColor=#d79b00;verticalAlign=bottom;" edge="1" parent="1" source="orders-r1" target="stops-r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK — primary key &amp;#183; FK — foreign key&lt;br&gt;U — part of a unique constraint&lt;br&gt;IX — indexed &amp;#183; GEN — generated column&lt;br&gt;JSON — full API payload retained&lt;br&gt;&lt;font color=&quot;#888888&quot;&gt;grey&lt;/font&gt; = SQL type &amp;#183; &lt;font color=&quot;#3d7a3d&quot;&gt;green&lt;/font&gt; = source field / note" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="n_key" value="&lt;b&gt;Why a surrogate key&lt;/b&gt; &amp;#8212; ADR-0002&lt;br&gt;&lt;br&gt;The natural key is (source_key, order_number): Order Numbers are unique only &lt;i&gt;within&lt;/i&gt; a dispatch system. order_id is a surrogate we control, so a second Source can be added with no schema change and no possible collision.&lt;br&gt;&lt;br&gt;route_stops carries source_key in its FK purely so the pair (order_id, source_key) is what it points at &amp;#8212; the parent&#x27;s Source travels with the child." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="300" height="210" as="geometry"/></mxCell>
        <mxCell id="n_raw" value="&lt;b&gt;Typed columns + retained raw&lt;/b&gt; &amp;#8212; ADR-0004&lt;br&gt;&lt;br&gt;Reports filter on typed, indexed columns; the complete API payload is kept per row so nothing is ever lost.&lt;br&gt;&lt;br&gt;Deliberately &lt;i&gt;not&lt;/i&gt; given a column: the stop cancellation date (populated on Orders that were never cancelled), the commission override (a delimited multi-value string), both distance fields (units unconfirmed) and the numeric stop status code (undocumented). They live in raw only, so reaching for one is a deliberate act." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="300" height="230" as="geometry"/></mxCell>
        <mxCell id="n_time" value="&lt;b&gt;Timestamps&lt;/b&gt; &amp;#8212; ADR-0001&lt;br&gt;&lt;br&gt;The API sends no offsets and three formats. Every timestamp is parsed as America/New_York (HawkExpress is in Miami) and stored as timestamptz, with the assumption recorded per row in timezone_assumption &amp;#8212; so a wrong assumption is a re-interpretation, not a re-fetch." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="n_terminal" value="&lt;b&gt;Terminal vs In Flight&lt;/b&gt;&lt;br&gt;&lt;br&gt;is_terminal is &lt;i&gt;generated&lt;/i&gt;, never stored by hand, so it cannot disagree with order_status:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;coalesce(lower(order_status) in&lt;br&gt;&amp;#160;(&#x27;completed&#x27;,&#x27;cancelled&#x27;,&#x27;canceled&#x27;), false)&lt;/font&gt;&lt;br&gt;&lt;br&gt;The coalesce matters: a status-less Order is In Flight, not neither. Without it, &lt;font face=&quot;Courier New&quot;&gt;where not is_terminal&lt;/font&gt; is NULL and the sweep silently skips exactly the Orders it exists to chase (migration 0005).&lt;br&gt;&lt;br&gt;Partial index orders_in_flight_idx covers only those rows, so the straggler sweep stays cheap." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1320" y="40" width="320" height="260" as="geometry"/></mxCell>
        <mxCell id="n_stopid" value="&lt;b&gt;dispatch_stop_id is not unique&lt;/b&gt; &amp;#8212; ADR-0005&lt;br&gt;&lt;br&gt;0002 enforced uniqueness on the dispatch system&#x27;s own stop id. The archive disproved it: Orders 305804 and 305805 are different Orders, placed 53 minutes apart, and both Final Stops carry route_stop_id 295832 &amp;#8212; 23 collisions across 338,144 stops.&lt;br&gt;&lt;br&gt;0004 dropped the constraint and kept an index. A stop is identified by our own surrogate, or by (order_id, stop_position); the dispatch id is only good for matching back to the vendor.&lt;br&gt;&lt;br&gt;A First Stop usually has none at all, so the column is nullable." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1320" y="330" width="320" height="260" as="geometry"/></mxCell>
        <mxCell id="n_location" value="&lt;b&gt;Location includes the suite&lt;/b&gt;&lt;br&gt;&lt;br&gt;route_stops_location_idx is (company, address, suite, city). One building routinely houses many Companies, so a street address alone never identifies a Location &amp;#8212; dedup on street alone merges unrelated businesses.&lt;br&gt;&lt;br&gt;Company &amp;#8800; Customer: a Customer&#x27;s freight is routinely collected from a third party&#x27;s premises. The Customer is on the Order (customer_number); the Company is on the Stop." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1320" y="620" width="320" height="210" as="geometry"/></mxCell>
        <mxCell id="n_pos" value="&lt;b&gt;Stops are positional&lt;/b&gt;&lt;br&gt;&lt;br&gt;unique (order_id, stop_position), 1-based. Most Orders have two stops but three and five occur, so nothing assumes a count and nothing is called &quot;the pickup&quot; &amp;#8212; only First Stop and Final Stop." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1320" y="860" width="320" height="140" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Ingest flow" id="dwb-orders-ingest">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="f_api" value="Digital Waybill API
(get_orders.py — paged fetch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="f_archive" value="JSON archive
output/orders/*.json  (169k files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="f_sweep" value="In Flight sweep
re-fetch non-terminal Orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="f_coerce" value="dwb.coerce

timestamp (assume Eastern)
integer · money · quantity · text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="340" y="150" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="f_stg_o" value="staging_orders  (temp)
COPY, on commit delete rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="f_stg_s" value="staging_stops  (temp)
COPY, on commit delete rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="640" y="280" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="f_upsert" value="&lt;b&gt;Revision-guarded upsert&lt;/b&gt;&lt;br&gt;&lt;br&gt;distinct on (source_key, order_number)&lt;br&gt;order by revision desc&lt;br&gt;&lt;br&gt;on conflict do update&lt;br&gt;&lt;b&gt;where&lt;/b&gt; excluded.revision is not null&lt;br&gt;and (orders.revision is null&lt;br&gt;&amp;#160;&amp;#160;or excluded.revision &amp;gt; orders.revision)&lt;br&gt;&lt;br&gt;returning order_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;fontColor=#1a1a1a;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="40" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="f_replace" value="&lt;b&gt;Replace stops wholesale&lt;/b&gt;&lt;br&gt;&lt;br&gt;delete from route_stops&lt;br&gt;where order_id = any(written)&lt;br&gt;&lt;br&gt;then insert the staged stops for&lt;br&gt;those Orders only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;fontColor=#1a1a1a;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="260" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="f_orders" value="orders" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1340" y="60" width="160" height="100" as="geometry"/></mxCell>
        <mxCell id="f_stops" value="route_stops" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1340" y="250" width="160" height="100" as="geometry"/></mxCell>
        <mxCell id="f_prog" value="import_progress" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1340" y="430" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="fe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#82b366;fontColor=#82b366;endArrow=block;endFill=1;" edge="1" parent="1" source="f_api" target="f_coerce"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#82b366;fontColor=#82b366;endArrow=block;endFill=1;" edge="1" parent="1" source="f_archive" target="f_coerce"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#82b366;fontColor=#82b366;endArrow=block;endFill=1;" edge="1" parent="1" source="f_sweep" target="f_coerce"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe4" value="order rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#d6b656;fontColor=#d6b656;endArrow=block;endFill=1;" edge="1" parent="1" source="f_coerce" target="f_stg_o"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe5" value="stop rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#d6b656;fontColor=#d6b656;endArrow=block;endFill=1;" edge="1" parent="1" source="f_coerce" target="f_stg_s"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#999999;fontColor=#999999;endArrow=block;endFill=1;" edge="1" parent="1" source="f_stg_o" target="f_upsert"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#6c8ebf;fontColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" parent="1" source="f_upsert" target="f_orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe8" value="written order_ids" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#6c8ebf;fontColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" parent="1" source="f_upsert" target="f_replace"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#999999;fontColor=#999999;endArrow=block;endFill=1;" edge="1" parent="1" source="f_stg_s" target="f_replace"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#d79b00;fontColor=#d79b00;endArrow=block;endFill=1;" edge="1" parent="1" source="f_replace" target="f_stops"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe11" value="last_file, counts
per batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#9673a6;fontColor=#9673a6;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="f_archive" target="f_prog"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe12" value="resume point" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#9673a6;fontColor=#9673a6;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="f_prog" target="f_archive"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe13" value="not is_terminal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#6c8ebf;fontColor=#6c8ebf;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="f_orders" target="f_sweep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_n1" value="&lt;b&gt;One path in&lt;/b&gt;&lt;br&gt;&lt;br&gt;The archive importer and the live fetcher share this path, so there is one set of coercion rules to keep honest rather than two.&lt;br&gt;&lt;br&gt;Set-based, not row-by-row: COPY into temp staging, then two statements. 169,000 Orders row-at-a-time would take hours." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="300" y="480" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="f_n2" value="&lt;b&gt;Why the guard makes re-runs safe&lt;/b&gt;&lt;br&gt;&lt;br&gt;An incoming Order is written only if its Revision is &lt;i&gt;strictly&lt;/i&gt; newer. An equal Revision is a no-op.&lt;br&gt;&lt;br&gt;That is what lets a resumed import re-read files, overlapping fetch pages re-send Orders, and the sweep re-check stragglers &amp;#8212; and stops a slow backfill from overwriting a live fetch with staler data.&lt;br&gt;&lt;br&gt;Stops are replaced, not merged: a stop that vanished upstream must vanish here too. Only Orders that actually won the guard have their stops touched." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="900" y="480" width="340" height="230" as="geometry"/></mxCell>
        <mxCell id="f_n3" value="&lt;b&gt;Resume, not restart&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reading 169k files out of a synced iCloud folder makes interruption a normal event. Each batch checkpoints its last file, so a resumed run starts near there. Re-reading a file or two is free &amp;#8212; the guard makes it a no-op." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1300" y="560" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="f_n4" value="&lt;b&gt;Chasing In Flight Orders&lt;/b&gt;&lt;br&gt;&lt;br&gt;orders_in_flight_idx is a partial index over &lt;font face=&quot;Courier New&quot;&gt;where not is_terminal&lt;/font&gt; &amp;#8212; a small index over a small set. Completed and Cancelled Orders are never re-fetched; everything else is." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1560" y="60" width="300" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
