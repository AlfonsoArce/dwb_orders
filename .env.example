# Digital Waybill API credentials
# Copy this file to .env and fill in your real values.
# .env is git-ignored so your key is never committed.

# Required
DWB_CID=your_company_id
DWB_KEY=your_api_key

# Optional - only for QuickEntry (customer-scoped) access
# DWB_CUSTOMER_NUMBER=DYN833
# DWB_PASSWORD=yourpassword

# Postgres (docker compose up -d)
# The password is written here once. The connection string deliberately does
# not repeat it: the tooling reads POSTGRES_PASSWORD when the DSN carries no
# password of its own, so the secret lives in exactly one place and one format.
POSTGRES_PASSWORD=choose_a_password
DWB_DSN=postgresql://dwb@127.0.0.1:5434/dwb_orders

# The Orders viewer's database user - read-only, granted SELECT and nothing
# else. Separate from DWB_DSN above because it is a different account, and its
# own connection string because inside the compose network the database
# answers on db:5432, not on the loopback port it publishes. The address below
# is the one to use when running the viewer on the host.
#
# resolve_viewer_password() in dwb/config.py reads DWB_VIEWER_PASSWORD and
# deliberately never falls back to POSTGRES_PASSWORD, which is the *admin*
# password: a viewer reusing it defeats the point of a second account.
#
# Migration 0006 creates the role without a password, because migrations are
# committed to a public repository. Set one once, after applying migrations:
#
#   psql "$DWB_DSN" -c "alter role dwb_viewer password 'the value below'"
#
# Until that is done the role exists but cannot log in, and the failure looks
# like a misconfiguration rather than a missing step.
DWB_VIEWER_PASSWORD=choose_a_second_password
DWB_VIEWER_DSN=postgresql://dwb_viewer@127.0.0.1:5434/dwb_orders

# Optional - only if the default ports collide with something else
# DWB_PG_PORT=5434
# DWB_ADMINER_PORT=8081
# DWB_VIEWER_PORT=8082
