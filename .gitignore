# Secrets - never commit real credentials
.env
.env.*
!.env.example

# Real data directories.
#
# input/  = source HawkExpress invoice PDFs (customer PII)
# output/ = fetched orders, workbooks and backups (customer PII)
#
# The *files* never get committed, but the *folder layout* does, so a fresh
# clone lands with the same tree the scripts expect. Each directory carries a
# .gitkeep marker; everything else in these trees is ignored.
input/**
!input/**/
!input/**/.gitkeep
output/**
!output/**/
!output/**/.gitkeep

# Log files
logs/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv.nosync/
venv/
env/
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Claude Code - share the slash commands, keep per-machine settings local
.claude/settings.local.json

# draw.io scratch files, left next to the diagram it is editing
*.drawio.bkp
*.drawio.dtmp

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Agent working state — tickets and specs reference customer data (see input/, output/ above)
.scratch/
